# OpenAI 兼容 API / 中转站配置示例
# 若不配置 API Key，推演局会自动切换至「内置离线演示模式」，开箱即可体验完整流程与导出。

# 二选一即可：OPENAI_API_KEY / API_KEY
OPENAI_API_KEY=sk-your-relay-key

# 二选一即可：OPENAI_BASE_URL / BASE_URL（只填域名时后端会自动补全 /v1）
OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：允许跨域访问的前端来源（逗号分隔，设为 * 表示允许任意来源）
# 默认允许本地 http://127.0.0.1:8000、http://localhost:8000 及本地文件预览
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# 可选：单 IP 每分钟最大推演请求数（设为 0 关闭限流）
RATE_LIMIT_PER_MINUTE=20

# 可选：多 Agent 暗房阶段最大并发连接数（1-10）
MAX_CONCURRENT_AGENTS=6
